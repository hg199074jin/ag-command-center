          atuin search -i
        else
          echo "ℹ️ atuin 未安装。"
          pause
        fi
        ;;
      "Shell")
        "${SHELL:-/bin/zsh}"
        ;;
      *)
        return 0
        ;;
    esac
  done
}

# ------------------------------------------------------------
# 非交互子命令
# ------------------------------------------------------------

show_status() {
  local cur
  local n

  cur=$(current_project 2>/dev/null || true)
  if [ -n "$cur" ]; then
    echo "Current Project : $(basename "$cur") ($(pretty_path "$cur"))"
  else
    echo "Current Project : (未设置)"
  fi

  if agentboard_alive; then
    echo "Agentboard      : ✅ :$AG_AGENTBOARD_PORT"
  else
    echo "Agentboard      : ❌ 离线"
  fi

  if docker info >/dev/null 2>&1; then
    n=$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
    echo "Docker          : ✅ ($n 个容器运行中)"
  else
    echo "Docker          : ❌ 不可用"
  fi

  if have tmux; then
    echo "tmux sessions   : $(list_sessions_raw | tr '\n' ' ')"
  else
    echo "tmux sessions   : ❌ tmux 不可用"
  fi

  have codex && echo "Codex           : $(codex --version 2>/dev/null | head -1)"
  have claude && echo "Claude          : $(claude --version 2>/dev/null | head -1)"

  echo "Disk /          : $(df -h / 2>/dev/null | awk 'NR==2{print $4" 可用"}')"
  if [ -d "$AG_ORICO_VOLUME" ]; then
    echo "ORICO           : ✅ 已挂载"
  else
    echo "ORICO           : ⚠️ 未挂载"
  fi

  agent_ws_status_block
}

cmd_status() {
  show_status
}

cmd_doctor() {
  local t
  local ok=0
  local warn=0
  local hard=0
  local probe
  local probe_lower
  local probe_rc
  local reg_n=0
  local reg_bad=0
  local reg_f
  local cur

  echo "=== ag doctor（只读诊断，不做任何修改） ==="
  echo

  echo "--- 核心依赖 ---"
  for t in gum tmux jq yazi shasum codex claude; do
    if have "$t"; then
      printf '✅ %s\n' "$t"
      ok=$((ok + 1))
    else
      printf '❌ %s 未安装（核心功能受限）\n' "$t"
      hard=$((hard + 1))
    fi
  done

  echo
  echo "--- 可选工具 ---"
  for t in atuin lazydocker watchexec trivy act lefthook dust hyperfine scc \
           lazygit btop just git gh; do
    if have "$t"; then
      printf '✅ %s\n' "$t"
      ok=$((ok + 1))
    else
      printf '⚠️ %s 未安装（对应菜单不可用）\n' "$t"
      warn=$((warn + 1))
    fi
  done

  echo
  echo "--- 服务与环境 ---"

  if ! have docker; then
    echo "⚠️ Docker CLI 未安装（Docker 菜单不可用）"
    warn=$((warn + 1))
  else
    probe=$(docker info 2>&1)
    probe_rc=$?
    if [ "$probe_rc" -eq 0 ]; then
      echo "✅ Docker 可用"
    else
      probe_lower=$(printf '%s' "$probe" | tr '[:upper:]' '[:lower:]')
      case "$probe_lower" in
        *permission\ denied*|*operation\ not\ permitted*)
          echo "⚠️ Docker socket 权限不足（当前诊断环境受限，不能据此判断服务离线）"
          ;;
        *)
          echo "⚠️ Docker 不可用"
          ;;
      esac
      warn=$((warn + 1))
    fi
  fi

  if agentboard_alive; then
    echo "✅ Agentboard :$AG_AGENTBOARD_PORT 在线"
  else
    echo "⚠️ Agentboard :${AG_AGENTBOARD_PORT} 离线（launchd: ${AG_AGENTBOARD_LABEL}）"
    warn=$((warn + 1))
  fi

  if have tmux; then
    probe=$(tmux info 2>&1)
    probe_rc=$?
    if [ "$probe_rc" -eq 0 ]; then
      echo "✅ tmux 服务可达（$(list_sessions_raw | grep -c . || true) 个会话）"
    else
      probe_lower=$(printf '%s' "$probe" | tr '[:upper:]' '[:lower:]')
      case "$probe_lower" in
        *no\ server\ running*|*no\ sessions*)
          echo "✅ tmux 已安装（当前无运行会话）"
          ;;
        *permission\ denied*|*operation\ not\ permitted*)
          echo "⚠️ tmux socket 权限不足（当前诊断环境受限，不能据此判断服务离线）"
          warn=$((warn + 1))
          ;;
        *)
          echo "⚠️ tmux 服务不可达"
          warn=$((warn + 1))
          ;;
      esac
    fi
  fi

  if [ -d "$AG_ORICO_VOLUME" ]; then
    echo "✅ 外置盘 $AG_ORICO_VOLUME 已挂载"
  else
    echo "⚠️ 外置盘 $AG_ORICO_VOLUME 未挂载（项目记录将被保留，不会清理）"
    warn=$((warn + 1))
  fi

  echo
  echo "--- 状态文件 ---"

  if [ -d "$AG_STATE_DIR" ]; then
    echo "✅ 状态目录 $AG_STATE_DIR"
  else
    echo "ℹ️ 状态目录尚未创建（首次写入时自动建立）：$AG_STATE_DIR"
  fi

  [ -f "$AG_RECENT_FILE" ] && echo "✅ recent-projects（$(grep -c . "$AG_RECENT_FILE" 2>/dev/null || echo 0) 条）" \
    || echo "ℹ️ recent-projects 尚无记录"

  if [ -d "$AG_REGISTRY_DIR" ]; then
    for reg_f in "$AG_REGISTRY_DIR"/*.json; do
      [ -f "$reg_f" ] || continue
      reg_n=$((reg_n + 1))
      if have jq && ! jq empty "$reg_f" >/dev/null 2>&1; then
        reg_bad=$((reg_bad + 1))
      fi
    done
    if [ "$reg_bad" -eq 0 ]; then
      echo "✅ registry（${reg_n} 个项目，位于 ${AG_REGISTRY_DIR}）"
    else
      echo "❌ registry 有 ${reg_bad} 个损坏记录（共 ${reg_n} 个）"
      hard=$((hard + 1))
    fi
  else
    echo "ℹ️ registry 尚未创建（首次新建/启动项目时生成）"
  fi

  cur=$(current_project 2>/dev/null || true)
  if [ -n "$cur" ]; then
    if [ -d "$cur" ]; then
      echo "✅ current-project：$(pretty_path "$cur")"
    else
      echo "⚠️ current-project 指向不存在的目录：$(pretty_path "$cur")"
      warn=$((warn + 1))
    fi
  else
    echo "ℹ️ current-project 未设置"
  fi

  echo
  if [ "$hard" -gt 0 ]; then
    echo "结论：核心失败 ${hard} 项，警告 ${warn} 项。"
    return 2
  elif [ "$warn" -gt 0 ]; then
    echo "结论：核心功能可用，但有 ${warn} 项警告。"
    return 1
  else
    echo "结论：无异常（$ok 项工具就绪）。"
    return 0
  fi
}

cmd_project_current() {
  local cur
  cur=$(current_project 2>/dev/null || true)
  if [ -z "$cur" ]; then
    echo "未设置当前项目" >&2
    return 1
  fi
  printf '%s\n' "$cur"
}

cmd_project_list() {
  local line
  [ -s "$AG_RECENT_FILE" ] || return 0
  if [ ! -d "$AG_ORICO_VOLUME" ]; then
    echo "⚠️ 外置盘 $AG_ORICO_VOLUME 未挂载" >&2
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s\t%s\n' "$(basename "$line")" "$line"
  done < "$AG_RECENT_FILE"
}

cmd_session_list() {
  local s
  local cmd
  local kind

  have tmux || { echo "tmux 不可用" >&2; return 1; }

  while IFS= read -r s; do
    [ -n "$s" ] || continue
    cmd=$(session_command "$s")
    kind="-"
    case "$cmd" in
      codex) kind="codex" ;;
      claude) kind="claude" ;;
      node)
        if tmux capture-pane -p -t "=$s:" 2>/dev/null | head -40 | grep -qi 'codex'; then
          kind="codex"
        elif tmux capture-pane -p -t "=$s:" 2>/dev/null | head -40 | grep -qi 'claude'; then
          kind="claude"
        fi
        ;;
    esac
    printf '%s\t%s\t%s\n' "$s" "$kind" "$(session_path "$s")"
  done < <(list_sessions_raw)
}

# ------------------------------------------------------------
# Self-test
# ------------------------------------------------------------

self_test_registry() (
  local tmproot
  local id1
  local id2

  tmproot=$(mktemp -d "${TMPDIR:-/tmp}/ag3-regtest.XXXXXX") || {
    echo "FAIL self-test mktemp"
    return 1
  }
  trap 'rm -rf "$tmproot"' EXIT

  AG_STATE_DIR="$tmproot/state"
  AG_LOG_FILE="$AG_STATE_DIR/logs/ag.log"
  AG_RECENT_FILE="$AG_STATE_DIR/recent-projects"
  AG_CURRENT_FILE="$AG_STATE_DIR/current-project"
  AG_REGISTRY_DIR="$AG_STATE_DIR/projects"
  mkdir -p "$tmproot/demo-a" "$tmproot/demo-b" || return 1

  registry_create "demo-a" "$tmproot/demo-a" || { echo "FAIL registry_create"; return 1; }

  id1=$(registry_id_for_path "$tmproot/demo-a")
  [ -f "$AG_REGISTRY_DIR/${id1}.json" ] || { echo "FAIL registry file"; return 1; }
  jq empty "$AG_REGISTRY_DIR/${id1}.json" >/dev/null 2>&1 || { echo "FAIL registry json"; return 1; }
  [ "$(registry_get "$id1" lifecycle)" = "done" ] || { echo "FAIL lifecycle initial"; return 1; }

  registry_set_field "$id1" lifecycle active || { echo "FAIL registry_set_field write"; return 1; }
  [ "$(registry_get "$id1" lifecycle)" = "active" ] || { echo "FAIL registry_set_field"; return 1; }

  id2=$(registry_id_for_path "$tmproot/demo-b")
  [ "$id1" != "$id2" ] || { echo "FAIL registry ids distinct"; return 1; }
)

self_test() {
  local got

  got=$(sanitize_name 'my project:abc/test')
  [ "$got" = 'my-project-abc-test' ] || { echo "FAIL sanitize_name: $got"; return 1; }

  got=$(pretty_path "$HOME/test/path")
  # shellcheck disable=SC2088  # 期望输出就是字面量 ~/
  [ "$got" = '~/test/path' ] || { echo "FAIL pretty_path: $got"; return 1; }

  got=$(canonical_dir "$HOME")
  [ -n "$got" ] || { echo "FAIL canonical_dir"; return 1; }

  got=$(printf 'a b  c\n' | tr ' ' '\n' | grep -c .)
  [ "$got" = '3' ] || { echo "FAIL recipe-parse"; return 1; }

  self_test_registry || return 1

  if project_validate_name "a/b"; then echo "FAIL validate slash"; return 1; fi
  if project_validate_name ".."; then echo "FAIL validate dotdot"; return 1; fi
  if project_validate_name "   "; then echo "FAIL validate blank"; return 1; fi
  project_validate_name "ok-name" || { echo "FAIL validate ok"; return 1; }

  echo "ag self-test: PASS"
}

# ------------------------------------------------------------
# 交互主菜单
# ------------------------------------------------------------

main_menu() {
  require_gum || exit 1

  banner

  while true; do
    c=$(menu_pick "主菜单" \
      "🤖 Agent" "📁 项目" "🛠 开发" "🖥 工作台" "🧠 辅助" "退出") || return 0

    case "$c" in
      "🤖 Agent") agent_menu ;;
      "📁 项目") project_menu ;;
      "🛠 开发") dev_menu ;;
      "🖥 工作台") workstation_menu ;;
      "🧠 辅助") assist_menu ;;
      *) return 0 ;;
    esac
  done
}

# ------------------------------------------------------------
# Agent Workstation 集成（agent-notify 状态，V1.1 增量）
# ------------------------------------------------------------
AGENT_WS_STATE_DIR="$HOME/.agent-workstation/state"
AGENT_WS_JQ="/usr/bin/jq"
command -v jq >/dev/null 2>&1 && AGENT_WS_JQ="$(command -v jq)"
: "${AG_AGENT_WS_DONE_TTL_HOURS:=24}"

agent_ws_valid_id() {
  local id="$1"
  [ -n "$id" ] || return 1
  [ "$id" != '.' ] && [ "$id" != '..' ] || return 1
  case "$id" in
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
}

agent_ws_iso_epoch() {
  local normalized
  normalized=$(printf '%s' "$1" | sed -E 's/Z$/+0000/; s/([+-][0-9]{2}):([0-9]{2})$/\1\2/')
  date -j -f '%Y-%m-%dT%H:%M:%S%z' "$normalized" '+%s' 2>/dev/null
}

agent_ws_done_expired() {
  local status="$1"
  local updated="$2"
  local updated_epoch
  local now_epoch
  local ttl_seconds

  [ "$status" = 'DONE' ] || return 1
  [ -n "$updated" ] && [ "$updated" != '-' ] || return 1
  updated_epoch=$(agent_ws_iso_epoch "$updated") || return 1
  now_epoch=$(date '+%s')
  ttl_seconds=$((AG_AGENT_WS_DONE_TTL_HOURS * 3600))
  [ "$((now_epoch - updated_epoch))" -gt "$ttl_seconds" ]
}

agent_ws_record_row() {
  local file="$1"
  "$AGENT_WS_JQ" -er \
    '[(.status // "?"), (.agent // "?"), (.project // "?"), (.tmux_session // "-"), (.tmux_window // "-"), (.tmux_pane // "-"), (.id // "-"), (.updated_at // "-")] | @tsv' \
    "$file" 2>/dev/null
}

# 输出 TSV：status agent project tmux_session tmux_window tmux_pane id updated_at
# $1 = 过滤器：空=全部；具体状态名；BAD=FAILED+STALE
agent_ws_rows() {
  local filter="${1:-}"
  local f row st ag pr ts tw tp id updated
  [ -d "$AGENT_WS_STATE_DIR" ] || return 0
  [ -x "$AGENT_WS_JQ" ] || return 0
  for f in "$AGENT_WS_STATE_DIR"/*.json; do
    [ -f "$f" ] || continue
    row=$(agent_ws_record_row "$f") || continue
    [ -n "$row" ] || continue
    IFS=$'\t' read -r st ag pr ts tw tp id updated <<<"$row"
    case "$st" in
      RUNNING|WAITING|DONE|FAILED|STALE|UNKNOWN) ;;
      *) continue ;;
    esac
    agent_ws_valid_id "$id" || continue
    case "$id" in
      e2e-*) continue ;;
    esac
    agent_ws_done_expired "$st" "$updated" && continue
    if [ -n "$filter" ]; then
      if [ "$filter" = "BAD" ]; then
        [ "$st" = "FAILED" ] || [ "$st" = "STALE" ] || continue
      else
        [ "$st" = "$filter" ] || continue
      fi
    fi
    printf '%s\n' "$row"
  done
  return 0
}

agent_ws_print_rows() { # $1=rows [$2="n" 时每行前加编号]
  local numbered="${2:-}"
  printf '%s\n' "$1" | awk -F'\t' -v numbered="$numbered" '{
    i=$1; icon="○";
    if(i=="RUNNING")icon="●"; else if(i=="WAITING")icon="⚠"; else if(i=="DONE")icon="✓"; else if(i=="FAILED"||i=="STALE")icon="✕";
    if(numbered=="n")
      printf "  %d) %s %-8s %-7s tmux=%s:%s (%s)\n", NR, icon, $2, $3, $4, $5, $7;
    else
      printf "  %s %-8s %-7s tmux=%s:%s (%s)\n", icon, $2, $3, $4, $5, $7;
  }'
}

# $1..$7 = st ag pr ts tw tp id
agent_ws_jump() {
  local st="$1" ag="$2" pr="$3" ts="$4" tw="$5" tp="$6" id="$7"
  local TMUX_BIN="/opt/homebrew/bin/tmux"
  [ "$ts" = '-' ] && ts=""
  [ "$tw" = '-' ] && tw=""
  [ "$tp" = '-' ] && tp=""
  [ -x "$TMUX_BIN" ] || TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
  if [ -z "$TMUX_BIN" ]; then
    echo "tmux 不可用"
    return 1
  fi
  if [ -z "$ts" ]; then
    echo "Agent ${id} 无 tmux 定位信息 (project=${pr})"
    return 1
  fi
  local target="=${ts}"
  [ -n "$tw" ] && target="${target}:${tw}"
  if [ -n "${AGENT_WS_DRY_RUN:-}" ]; then
    echo "[dry-run] id=$id target=$target pane=${tp:--} mode=$( [ -n "${TMUX:-}" ] && echo switch || echo attach )"
    return 0
  fi
  if [ -n "${TMUX:-}" ]; then
    "$TMUX_BIN" switch-client -t "$target" 2>/dev/null || "$TMUX_BIN" switch-client -t "=${ts}"
    [ -n "$tp" ] && "$TMUX_BIN" select-pane -t "$tp" >/dev/null 2>&1
  else
    # 先把 session 当前 window/pane 设到 Agent 位置，再 attach（tmux 3.7c 用 = 会话名: 精确匹配）
    [ -n "$tw" ] && "$TMUX_BIN" select-window -t "$target" >/dev/null 2>&1
    [ -n "$tp" ] && "$TMUX_BIN" select-pane -t "$tp" >/dev/null 2>&1
    "$TMUX_BIN" attach-session -t "=${ts}"
  fi
}

agent_ws_actionable_waiting_rows() {
  local rows
  local row
  local st ag pr ts tw tp id updated

  rows=$(agent_ws_rows WAITING)
  [ -n "$rows" ] || return 0
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    IFS=$'\t' read -r st ag pr ts tw tp id updated <<<"$row"
    [ -n "$ts" ] && [ "$ts" != '-' ] || continue
    session_exists "$ts" || continue
    printf '%s\n' "$row"
  done <<EOF
$rows
EOF
}

cmd_agent_waiting() {
  local rows pick n count
  rows=$(agent_ws_actionable_waiting_rows)
  if [ -z "$rows" ]; then
    echo "当前没有可跳转的 Waiting Agent"
    return 0
  fi
  count=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
  if [ "$count" -eq 1 ]; then
    pick="$rows"
  else
    agent_ws_print_rows "$rows" n
    printf '输入编号选择 Agent（回车取消）：'
    read -r n
    case "$n" in
      ''|*[!0-9]*) echo "已取消"; return 0 ;;
    esac
    [ "$n" -ge 1 ] || { echo "编号无效"; return 1; }
    pick=$(printf '%s\n' "$rows" | sed -n "${n}p")
    if [ -z "$pick" ]; then echo "编号无效"; return 1; fi
  fi
  IFS=$'\t' read -r st ag pr ts tw tp id _updated <<<"$pick"
  agent_ws_jump "$st" "$ag" "$pr" "$ts" "$tw" "$tp" "$id"
}

cmd_agent_failed() {
  local rows
  rows=$(agent_ws_rows BAD)
  if [ -z "$rows" ]; then
    echo "当前没有 Failed/Stale Agent"
    return 0
  fi
  agent_ws_print_rows "$rows"
  return 0
}

cmd_agent_open() {
  local requested_id="${1:-}"
  local f row st ag pr ts tw tp id updated
  if [ -z "$requested_id" ]; then
    echo "用法：ag open <agent-session-id>"
    return 2
  fi
  if ! agent_ws_valid_id "$requested_id"; then
    echo "Agent session id 非法。"
    return 2
  fi
  [ -x "$AGENT_WS_JQ" ] || { echo "jq 不可用"; return 1; }
  f="$AGENT_WS_STATE_DIR/${requested_id}.json"
  if [ ! -f "$f" ]; then
    echo "未找到 Agent session：$requested_id"
    return 1
  fi
  row=$(agent_ws_record_row "$f") || { echo "Agent session 记录无法解析：$requested_id"; return 1; }
  IFS=$'\t' read -r st ag pr ts tw tp id updated <<<"$row"
  if [ "$id" != "$requested_id" ]; then
    echo "Agent session 记录 ID 不匹配：$requested_id"
    return 1
  fi
  case "$st" in
    RUNNING|WAITING|DONE|FAILED|STALE|UNKNOWN) ;;
    *) echo "Agent session 记录异常：$id"; return 1 ;;
  esac
  agent_ws_jump "$st" "$ag" "$pr" "$ts" "$tw" "$tp" "$id"
}

agent_ws_status_block() {
  local all
  all=$(agent_ws_rows "")
  [ -n "$all" ] || return 0
  echo ""
  echo "Agent Workstation :"
  agent_ws_print_rows "$all"
}

# ------------------------------------------------------------
# CLI
# ------------------------------------------------------------

trap 'printf "\n"; exit 0' INT TERM

case "${1:-}" in

  --version|-v)
    echo "ag $AG_VERSION"
    ;;

  --help|-h)
    cat <<EOF_HELP
ag $AG_VERSION - AG Command Center

交互菜单：
  ag
      打开分层菜单（Agent / 项目 / 开发 / 工作台 / 辅助）
      新建 Codex/Claude 会话时可选择：标准模式（SAFE）/ 少打断模式（AUTO）/ YOLO 模式（信任项目）
      工作台 → 会话中心：正在运行 / 已完成

非交互子命令（适合人与 Agent 脚本调用）：
  ag status            工作台状态概览
  ag doctor            只读诊断（不做任何修改）
                       doctor 退出码：0=健康，1=警告/环境受限，2=核心失败
  ag w                 进入 WAITING 的 Agent（agent-notify）
  ag f                 列出 FAILED/STALE 的 Agent（agent-notify）
  ag open <id>         按 agent-session-id 打开对应 tmux 位置
  ag project current   输出当前项目完整路径
  ag project list      最近项目（名称<TAB>路径）
  ag session list      tmux 会话（名称<TAB>Agent类型<TAB>路径）
  ag --version / --self-test / --help
EOF_HELP
    ;;

  --self-test)
    self_test
    ;;

  status)
    cmd_status
    ;;

  doctor)
    cmd_doctor
    echo
    cmd_doctor_v24
    ;;

  project)
    case "${2:-}" in
      current) cmd_project_current ;;
      list) cmd_project_list ;;
      *)
        echo "用法：ag project current | ag project list"
        exit 2
        ;;
    esac
    ;;

  session)
    case "${2:-}" in
      list) cmd_session_list ;;
      *)
        echo "用法：ag session list"
        exit 2
        ;;
    esac
    ;;

  w)
    cmd_agent_waiting
    ;;

  f)
    cmd_agent_failed
    ;;

  open)
    cmd_agent_open "${2:-}"
    ;;

  '')
    main_menu
    ;;

  *)
    echo "未知参数：$1"
    echo "执行 ag --help 查看帮助。"
    exit 2
    ;;

esac
