#!/usr/bin/env python3
"""ag-run — ag v2.4 统一启动器（SAFE/AUTO/YOLO）。

用法：
  ag-run codex [--mode safe|auto|yolo] [--cwd DIR] [-- --extra-args]
  ag-run claude --mode auto
  ag-run resolve codex --mode yolo [--json]   # 只解析不启动
  ag-run gate codex --cwd DIR                 # YOLO gate
  ag-run record-launch --provider codex --mode auto --session S --cwd D
  ag-run doctor [--fix-safe]
"""

import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/share/ag"))

from runtime import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
